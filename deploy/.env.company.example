# Copy outside the source tree to /data/apps/plan-review/company/config/app.env.
# APP_IMAGE stays blank until a real image is built and its digest recorded.
APP_IMAGE=
TZ=Europe/Budapest
APP_DATA_HOST_PATH=/data/apps/plan-review/company/data
MYSQL_DATA_HOST_PATH=/data/apps/plan-review/company/mysqldata
DATABASE_PASSWORD_FILE=/data/apps/plan-review/company/secrets/database_password
DATABASE_ROOT_PASSWORD_FILE=/data/apps/plan-review/company/secrets/database_root_password
MYSQL_CLIENT_FILE=/data/apps/plan-review/company/secrets/mysql_client
